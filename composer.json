{
    "name": "migears/debug",
    "description": "Developer-friendly exception and error page",
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "keywords": [
        "debug",
        "error",
        "exception",
        "development",
        "migears"
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "MiGears\\Debug\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\Debug\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
